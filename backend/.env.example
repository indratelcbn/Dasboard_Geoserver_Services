# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# GeoServer REST API
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=Admin@123

# Public URL used by the frontend map (OWS/WMS/WFS/WMTS endpoints)
GEOSERVER_PUBLIC_URL=http://localhost:8080/geoserver

# PostgreSQL / PostGIS
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres123
PGDATABASE=geodb

# Application database (auth, users, settings) — separate from spatial data
# Docker: host "appdb" port 5432 | Local dev: host "localhost" port 5433
DATABASE_URL=postgresql://appuser:app123@localhost:5433/appdb
